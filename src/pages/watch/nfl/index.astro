---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LastUpdated from '../../../components/LastUpdated.astro';
import AffiliateDisclosure from '../../../components/AffiliateDisclosure.astro';

import teamsData from '../../../data/teams.json';
import { generatePageMeta, generateSiteSchema, generateBreadcrumbSchema } from '../../../lib/seo';
import type { SportsTeam } from '../../../types';

const teams = (teamsData.teams as unknown as SportsTeam[]).filter((t) => t.league === 'NFL');
const meta = generatePageMeta('hub-sports', { league: 'NFL' });
const breadcrumbs = [
  { name: 'Sports', url: '/watch/' },
  { name: 'NFL', url: '/watch/nfl/' }
];

const schemas = [
  ...generateSiteSchema(),
  generateBreadcrumbSchema(breadcrumbs)
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  jsonLd={schemas}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mb-8">
      <LastUpdated />
      <h1 class="font-editorial text-3xl sm:text-5xl font-bold tracking-tight text-[#1A1A1A] mt-2">
        How to Watch NFL Games Without Cable (All 32 Teams)
      </h1>
      <p class="text-base text-[#5C5C5C] mt-2 max-w-2xl leading-relaxed">
        Complete broadcasting guide for all 32 NFL franchises: local CBS & FOX feeds, Sunday Night Football on NBC, and Monday Night Football on ESPN.
      </p>

      <div class="flex gap-2 mt-5">
        <a
          href="/watch/"
          class="px-3 py-1 rounded text-xs font-medium bg-white border border-[#E7E2DA] text-[#5C5C5C] hover:text-[#1A1A1A]"
        >
          All Leagues
        </a>
        <a
          href="/watch/nfl/"
          class="px-3 py-1 rounded text-xs font-semibold bg-[#0F5C4A] text-white"
        >
          NFL Teams (32)
        </a>
        <a
          href="/watch/nba/"
          class="px-3 py-1 rounded text-xs font-medium bg-white border border-[#E7E2DA] text-[#5C5C5C] hover:text-[#1A1A1A]"
        >
          NBA Teams (30)
        </a>
      </div>
    </div>

    <AffiliateDisclosure />

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 my-8">
      {teams.map((t) => (
        <a
          href={`/watch/nfl/${t.slug}/`}
          class="group block p-4 bg-white border border-[#E7E2DA] hover:border-[#0F5C4A] rounded hover:shadow-2xs transition-all"
        >
          <div class="flex items-center justify-between gap-1 mb-1">
            <span class="font-editorial text-base font-bold text-[#1A1A1A] group-hover:text-[#0F5C4A] truncate">
              {t.name}
            </span>
            <span class="text-[10px] text-stone-400 font-semibold uppercase">
              {t.conferenceOrDivision}
            </span>
          </div>
          <p class="text-xs text-[#5C5C5C] line-clamp-2 leading-relaxed">
            {t.broadcastingSummary}
          </p>
          <span class="text-xs font-semibold text-[#0F5C4A] mt-2 inline-block">
            View TV channels & schedule &rarr;
          </span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
