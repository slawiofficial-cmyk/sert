---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LastUpdated from '../components/LastUpdated.astro';
import { generatePageMeta, generateSiteSchema, generateBreadcrumbSchema } from '../lib/seo';

const meta = generatePageMeta('trust', { title: 'Contact Our Editorial Team', slug: 'contact' });
const breadcrumbs = [
  { name: 'Editorial', url: '/about/' },
  { name: 'Contact', url: '/contact/' }
];
const schemas = [
  ...generateSiteSchema(),
  generateBreadcrumbSchema(breadcrumbs)
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  jsonLd={schemas}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
    <Breadcrumbs items={breadcrumbs} />
    <LastUpdated date="October 1, 2026" />

    <div class="space-y-6 text-[#1A1A1A] leading-relaxed mt-6">
      <h1 class="font-editorial text-3xl sm:text-5xl font-bold tracking-tight">
        Contact Our Editorial Team
      </h1>
      <p class="text-lg text-[#5C5C5C]">
        Have a question regarding local station reception, channel lineups, or corrections? We welcome feedback from readers and industry representatives.
      </p>

      <div class="bg-white border border-[#E7E2DA] rounded p-6 max-w-xl my-6">
        <form
          action="/contact/"
          method="POST"
          class="space-y-4"
          onsubmit="alert('Thank you! Your feedback has been noted for editorial review.'); return false;"
        >
          <div>
            <label for="contact-name" class="block text-xs font-semibold text-[#1A1A1A] mb-1">
              Your Name
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              class="w-full px-3 py-2 border border-[#E7E2DA] rounded text-sm focus:outline-2 focus:outline-[#0F5C4A]"
            />
          </div>
          <div>
            <label for="contact-email" class="block text-xs font-semibold text-[#1A1A1A] mb-1">
              Email Address
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              class="w-full px-3 py-2 border border-[#E7E2DA] rounded text-sm focus:outline-2 focus:outline-[#0F5C4A]"
            />
          </div>
          <div>
            <label for="contact-subject" class="block text-xs font-semibold text-[#1A1A1A] mb-1">
              Subject / Inquiry Type
            </label>
            <select
              id="contact-subject"
              name="subject"
              class="w-full px-3 py-2 border border-[#E7E2DA] rounded text-sm focus:outline-2 focus:outline-[#0F5C4A]"
            >
              <option>Channel Lineup Correction</option>
              <option>Local Affiliate Report</option>
              <option>Editorial Feedback</option>
              <option>General Question</option>
            </select>
          </div>
          <div>
            <label for="contact-message" class="block text-xs font-semibold text-[#1A1A1A] mb-1">
              Message
            </label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows="4"
              class="w-full px-3 py-2 border border-[#E7E2DA] rounded text-sm focus:outline-2 focus:outline-[#0F5C4A]"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full py-2.5 px-4 bg-[#0F5C4A] text-white font-semibold rounded text-sm hover:bg-[#0c4739] transition-colors"
          >
            Send Message to Editors
          </button>
        </form>
      </div>

      <div class="text-xs text-[#5C5C5C] space-y-1">
        <p>Direct Press & Editorial Email: editorial@livetvstreaming.services</p>
        <p>Mailing Address: LiveTVStreaming Editorial Lab, 500 Delaware Ave, Wilmington, DE 19801</p>
      </div>
    </div>
  </div>
</BaseLayout>
