---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LastUpdated from '../../components/LastUpdated.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';

import marketsData from '../../data/markets.json';
import { generatePageMeta, generateSiteSchema, generateBreadcrumbSchema } from '../../lib/seo';
import type { LocalMarket } from '../../types';

const markets = marketsData.markets as unknown as LocalMarket[];
const states = Array.from(new Set(markets.map((m) => m.state))).sort();

const meta = generatePageMeta('hub-local');
const breadcrumbs = [{ name: 'Local Markets Directory', url: '/local/' }];

const schemas = [
  ...generateSiteSchema(),
  generateBreadcrumbSchema(breadcrumbs)
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  jsonLd={schemas}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mb-8">
      <LastUpdated date="October 1, 2026" />
      <h1 class="font-editorial text-3xl sm:text-5xl font-bold tracking-tight text-[#1A1A1A] mt-2">
        Local Television Markets (Top 25 US DMAs)
      </h1>
      <p class="text-base text-[#5C5C5C] mt-2 max-w-2xl leading-relaxed">
        Compare local affiliate carriage (ABC, CBS, NBC, FOX, CW, PBS) for your television market without cable.
      </p>

      <!-- State Filter Pills -->
      <div class="flex flex-wrap gap-1.5 mt-5">
        <a
          href="/local/"
          class="px-2.5 py-1 rounded text-xs font-semibold bg-[#0F5C4A] text-white"
        >
          All States
        </a>
        {states.map((st) => (
          <a
            href={`/local/state/${st.toLowerCase()}/`}
            class="px-2.5 py-1 rounded text-xs font-medium bg-white border border-[#E7E2DA] text-[#5C5C5C] hover:text-[#1A1A1A] hover:border-[#0F5C4A]"
          >
            {st}
          </a>
        ))}
      </div>
    </div>

    <AffiliateDisclosure />

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 my-8">
      {markets.map((m) => (
        <a
          href={`/local/${m.slug}/`}
          class="group block p-4 bg-white border border-[#E7E2DA] hover:border-[#0F5C4A] rounded hover:shadow-2xs transition-all"
        >
          <div class="flex items-center justify-between gap-1 mb-1">
            <span class="font-editorial text-base font-bold text-[#1A1A1A] group-hover:text-[#0F5C4A]">
              {m.name}
            </span>
            <span class="text-[10px] text-[#0F5C4A] font-semibold bg-[#0F5C4A]/10 px-1.5 py-0.5 rounded">
              DMA #{m.dmaRank}
            </span>
          </div>
          <p class="text-xs text-[#5C5C5C]">
            Affiliates: {m.localAffiliates.abc}, {m.localAffiliates.cbs}, {m.localAffiliates.nbc}, {m.localAffiliates.fox}
          </p>
          <span class="text-xs font-semibold text-[#0F5C4A] mt-2 inline-block">
            Check local stations &rarr;
          </span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
