---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LastUpdated from '../components/LastUpdated.astro';
import { generatePageMeta, generateSiteSchema, generateBreadcrumbSchema } from '../lib/seo';

const meta = generatePageMeta('trust', { title: 'Terms of Service', slug: 'terms' });
const breadcrumbs = [
  { name: 'Editorial', url: '/about/' },
  { name: 'Terms of Service', url: '/terms/' }
];
const schemas = [
  ...generateSiteSchema(),
  generateBreadcrumbSchema(breadcrumbs)
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  jsonLd={schemas}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
    <Breadcrumbs items={breadcrumbs} />
    <LastUpdated date="October 1, 2026" />

    <div class="space-y-6 text-[#1A1A1A] leading-relaxed text-sm mt-6">
      <h1 class="font-editorial text-3xl sm:text-5xl font-bold tracking-tight text-[#1A1A1A]">
        Terms of Service
      </h1>
      <p class="text-[#5C5C5C]">Last Updated: October 1, 2026</p>
      <p>
        By accessing and using LiveTVStreaming.services, you agree to comply with and be bound by these Terms of Service.
      </p>

      <h2 class="font-editorial text-xl font-bold text-[#1A1A1A] mt-6">Informational Purposes Only</h2>
      <p>
        Content provided on this site is for general informational and educational guidance. While we audit pricing sheets and channel lineups monthly, streaming providers may adjust promotional terms, carriage agreements, or pricing at any time. Always verify current prices and terms directly on the provider's official checkout page prior to purchase.
      </p>
    </div>
  </div>
</BaseLayout>
