---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AuthorByline from '../components/AuthorByline.astro';
import LastUpdated from '../components/LastUpdated.astro';
import { generatePageMeta, generateSiteSchema, generateBreadcrumbSchema } from '../lib/seo';

const meta = generatePageMeta('trust', { title: 'About Our Team', slug: 'about' });
const breadcrumbs = [
  { name: 'Editorial', url: '/about/' },
  { name: 'About Us', url: '/about/' }
];
const schemas = [
  ...generateSiteSchema(),
  generateBreadcrumbSchema(breadcrumbs)
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  jsonLd={schemas}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
    <Breadcrumbs items={breadcrumbs} />
    <LastUpdated date="October 1, 2026" />

    <div class="space-y-6 text-[#1A1A1A] leading-relaxed mt-6">
      <h1 class="font-editorial text-3xl sm:text-5xl font-bold tracking-tight">
        About LiveTVStreaming.services
      </h1>
      <p class="text-lg text-[#5C5C5C]">
        We are an independent consumer publication dedicated exclusively to helping American households navigate the transition from cable and satellite television to live streaming.
      </p>

      <h2 class="font-editorial text-2xl font-bold mt-8">Our Mission</h2>
      <p>
        Traditional pay-TV is plagued by opaque equipment fees, two-year contracts, broadcast TV surcharges, and confusing bundle packages. Our sole mission is to bring transparency and empirical rigor to cord-cutting.
      </p>
      <p>
        Unlike generic tech websites that review everything from smart lightbulbs to gaming consoles, we focus 100% of our editorial resources on live television carriage, cloud DVR systems, regional sports networks, and local broadcast DMA reception.
      </p>

      <h2 class="font-editorial text-2xl font-bold mt-8">Editorial Independence</h2>
      <p>
        LiveTVStreaming.services does not accept sponsored reviews, paid placement, or pre-approval from streaming services. We maintain all accounts anonymously under consumer subscriptions to ensure our testing reflects the genuine customer experience.
      </p>

      <AuthorByline authorId="editorial-team" />
    </div>
  </div>
</BaseLayout>
