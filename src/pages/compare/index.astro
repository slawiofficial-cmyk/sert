---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LastUpdated from '../../components/LastUpdated.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';

import { getAllComparisonPairs } from '../../lib/coverage';
import { generatePageMeta, generateSiteSchema, generateBreadcrumbSchema } from '../../lib/seo';

const pairs = getAllComparisonPairs();
const meta = generatePageMeta('hub-compare');
const breadcrumbs = [{ name: 'Comparisons Directory', url: '/compare/' }];

const schemas = [
  ...generateSiteSchema(),
  generateBreadcrumbSchema(breadcrumbs)
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  jsonLd={schemas}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mb-8">
      <LastUpdated date="October 1, 2026" />
      <h1 class="font-editorial text-3xl sm:text-5xl font-bold tracking-tight text-[#1A1A1A] mt-2">
        Head-to-Head Streaming Comparisons ({pairs.length} Matchups)
      </h1>
      <p class="text-base text-[#5C5C5C] mt-2 max-w-2xl leading-relaxed">
        Every unique pairwise combination evaluated for price differences, exclusive channels, and cloud DVR specs.
      </p>
    </div>

    <AffiliateDisclosure />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 my-8">
      {pairs.map((p) => (
        <a
          href={`/compare/${p.slug}/`}
          class="group block p-4 bg-white border border-[#E7E2DA] hover:border-[#0F5C4A] rounded hover:shadow-2xs transition-all"
        >
          <span class="font-editorial text-lg font-bold text-[#1A1A1A] group-hover:text-[#0F5C4A] block">
            {p.a.name} vs. {p.b.name}
          </span>
          <p class="text-xs text-[#5C5C5C] mt-1">
            ${p.a.monthlyPrice.toFixed(0)}/mo vs. ${p.b.monthlyPrice.toFixed(0)}/mo · Lineup, DVR & stream limits
          </p>
          <span class="text-xs font-semibold text-[#0F5C4A] mt-3 inline-block">
            View comparison &rarr;
          </span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
