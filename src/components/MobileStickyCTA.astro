---
import Button from './Button.astro';
import { formatUsd, getMainPrice, getPromoLine, dataMeta } from '../lib/coverage';

interface Props {
  serviceName: string;
  shortName?: string;
  monthlyPrice: number;
  planName?: string;
  sourceUrl?: string;
  promoPrice?: number | null;
  promoDescription?: string | null;
  ctaUrl: string;
}

const {
  serviceName,
  shortName,
  monthlyPrice,
  planName,
  sourceUrl,
  promoPrice,
  promoDescription,
  ctaUrl
} = Astro.props;

const mainPrice = getMainPrice({ monthlyPrice });
const promoLine = getPromoLine({ promoPrice: promoPrice ?? null, promoDescription });
const labelName = shortName || serviceName;
---

<!-- Mobile Sticky Bottom CTA Bar -->
<!-- Visible only below 768px (md:hidden) on service review pages -->
<aside
  class="md:hidden fixed inset-x-0 bottom-0 z-40 bg-white border-t border-[#E7E2DA] shadow-[0_-4px_16px_rgba(0,0,0,0.06)] px-4 pt-2.5 pb-[calc(0.625rem+env(safe-area-inset-bottom,0px))]"
  aria-label={`Subscribe to ${serviceName}`}
>
  <div class="max-w-md mx-auto flex items-center justify-between gap-3">
    <div class="min-w-0">
      <span class="text-[11px] font-medium text-[#5C5C5C] truncate block">
        {serviceName}{planName ? ` · ${planName}` : ''}
      </span>
      <div class="flex items-baseline gap-1">
        <span class="font-editorial text-xl font-bold text-[#1A1A1A] tabular-nums leading-none">
          {formatUsd(mainPrice)}
        </span>
        <span class="text-xs text-[#5C5C5C]">/mo approx.</span>
      </div>
      {promoLine ? (
        <span class="text-[10px] text-[#C2410C] block leading-tight truncate">
          Promo: {promoLine}
        </span>
      ) : (
        <span class="text-[10px] text-[#5C5C5C] block leading-tight truncate">
          As of {dataMeta.lastVerifiedLabel}
        </span>
      )}
      {sourceUrl && (
        <a href={sourceUrl} target="_blank" rel="nofollow noopener" class="text-[10px] text-stone-400 underline">Source</a>
      )}
    </div>

    <Button
      href={ctaUrl}
      variant="primary"
      size="sm"
      class="shrink-0"
      ariaLabel={`Get ${labelName} official subscription`}
    >
      <span>Get {labelName}</span>
    </Button>
  </div>
</aside>
