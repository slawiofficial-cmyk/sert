---
export interface RelatedLinkItem {
  title: string;
  url: string;
  description?: string;
  badge?: string;
}

interface Props {
  title: string;
  links: RelatedLinkItem[];
  hubUrl?: string;
  hubLabel?: string;
}

const {
  title,
  links,
  hubUrl,
  hubLabel = 'View all in directory &rarr;'
} = Astro.props;
---

{links.length > 0 && (
  <section class="my-10 pt-8 border-t border-[#E7E2DA]">
    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-4">
      <h2 class="font-editorial text-xl font-bold text-[#1A1A1A]">
        {title}
      </h2>
      {hubUrl && (
        <a
          href={hubUrl}
          class="text-xs font-semibold text-[#0F5C4A] hover:underline"
        >
          {hubLabel}
        </a>
      )}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {links.map((link) => (
        <a
          href={link.url}
          class="group block p-3.5 bg-white border border-[#E7E2DA] rounded hover:border-[#0F5C4A] hover:shadow-2xs transition-all"
        >
          <div class="flex items-start justify-between gap-2">
            <span class="font-semibold text-sm text-[#1A1A1A] group-hover:text-[#0F5C4A] transition-colors leading-snug">
              {link.title}
            </span>
            {link.badge && (
              <span class="text-[10px] text-stone-500 bg-stone-100 px-1.5 py-0.5 rounded shrink-0">
                {link.badge}
              </span>
            )}
          </div>
          {link.description && (
            <p class="text-xs text-[#5C5C5C] mt-1 line-clamp-2 leading-relaxed">
              {link.description}
            </p>
          )}
        </a>
      ))}
    </div>
  </section>
)}
